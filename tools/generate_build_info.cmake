# Writes build_info.h with the commit the source tree is at, so the updater can tell whether the
# published build differs from the running one. Runs on every build. Uses git; falls back to the
# GITHUB_SHA environment variable; otherwise records "unknown".
#
# usage: cmake -DOUTPUT=<path/build_info.h> -DSOURCE_DIR=<repo root> -P generate_build_info.cmake

set(COMMIT "unknown")
set(COMMIT_DATE "")

find_package(Git QUIET)
if(GIT_EXECUTABLE)
    execute_process(
        COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" rev-parse HEAD
        OUTPUT_VARIABLE git_commit OUTPUT_STRIP_TRAILING_WHITESPACE
        RESULT_VARIABLE git_result ERROR_QUIET)
    if(git_result EQUAL 0 AND git_commit MATCHES "^[0-9a-f]+$")
        set(COMMIT "${git_commit}")
        execute_process(
            COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" show -s --format=%cI HEAD
            OUTPUT_VARIABLE git_date OUTPUT_STRIP_TRAILING_WHITESPACE
            RESULT_VARIABLE date_result ERROR_QUIET)
        if(date_result EQUAL 0)
            set(COMMIT_DATE "${git_date}")
        endif()
    endif()
endif()

if(COMMIT STREQUAL "unknown" AND DEFINED ENV{GITHUB_SHA} AND "$ENV{GITHUB_SHA}" MATCHES "^[0-9a-f]+$")
    set(COMMIT "$ENV{GITHUB_SHA}")
endif()

set(CONTENT "#pragma once\n// Generated by tools/generate_build_info.cmake on every build; do not edit.\n#define AUDIOCAPTURE_BUILD_COMMIT L\"${COMMIT}\"\n#define AUDIOCAPTURE_BUILD_COMMIT_DATE L\"${COMMIT_DATE}\"\n")

set(OLD "")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" OLD)
endif()
if(NOT OLD STREQUAL CONTENT)
    get_filename_component(dir "${OUTPUT}" DIRECTORY)
    file(MAKE_DIRECTORY "${dir}")
    file(WRITE "${OUTPUT}" "${CONTENT}")
    message(STATUS "build_info.h: commit ${COMMIT} ${COMMIT_DATE}")
endif()
